# Cambia esta clave por un texto largo y aleatorio. No compartas el archivo .env.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-unica

# Puerto que abrirá el navegador.
APP_PORT=8000

# Para otro equipo de la red agrega aquí la IP del servidor, por ejemplo:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo hace falta al publicar con HTTPS. Separa varios dominios con comas.
# CSRF_TRUSTED_ORIGINS=https://cuentas.ejemplo.com
CSRF_TRUSTED_ORIGINS=
